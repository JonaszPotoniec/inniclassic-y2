<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ImageView
        android:id="@+id/iv_main_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="#000000" />

    <LinearLayout
        android:id="@+id/layout_main_menu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingTop="0dp"
        android:visibility="visible"
        android:background="#00000000">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#55000000"
            android:gravity="top"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingBottom="8dp">

            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <Button android:id="@+id/btn_now_playing" android:layout_width="match_parent" android:layout_height="48dp" android:text="Now Playing" android:textColor="#FFFFFF" android:background="#00000000" android:gravity="left|center_vertical" android:paddingLeft="15dp" android:textSize="18sp" android:focusable="true"/>
                <TextView android:layout_width="wrap_content" android:layout_height="48dp" android:text="〉" android:textColor="#888888" android:gravity="center_vertical" android:layout_gravity="right" android:paddingRight="15dp" android:textSize="16sp" android:focusable="false" android:clickable="false"/>
            </FrameLayout>

            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <Button android:id="@+id/btn_play" android:layout_width="match_parent" android:layout_height="48dp" android:text="Music" android:textColor="#FFFFFF" android:background="#00000000" android:gravity="left|center_vertical" android:paddingLeft="15dp" android:textSize="18sp" android:focusable="true"/>
                <TextView android:layout_width="wrap_content" android:layout_height="48dp" android:text="〉" android:textColor="#888888" android:gravity="center_vertical" android:layout_gravity="right" android:paddingRight="15dp" android:textSize="16sp" android:focusable="false" android:clickable="false"/>
            </FrameLayout>

            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <Button android:id="@+id/btn_bluetooth" android:layout_width="match_parent" android:layout_height="48dp" android:text="Bluetooth" android:textColor="#FFFFFF" android:background="#00000000" android:gravity="left|center_vertical" android:paddingLeft="15dp" android:textSize="18sp" android:focusable="true"/>
                <TextView android:layout_width="wrap_content" android:layout_height="48dp" android:text="〉" android:textColor="#888888" android:gravity="center_vertical" android:layout_gravity="right" android:paddingRight="15dp" android:textSize="16sp" android:focusable="false" android:clickable="false"/>
            </FrameLayout>

            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <Button android:id="@+id/btn_settings" android:layout_width="match_parent" android:layout_height="48dp" android:text="Settings" android:textColor="#FFFFFF" android:background="#00000000" android:gravity="left|center_vertical" android:paddingLeft="15dp" android:textSize="18sp" android:focusable="true"/>
                <TextView android:layout_width="wrap_content" android:layout_height="48dp" android:text="〉" android:textColor="#888888" android:gravity="center_vertical" android:layout_gravity="right" android:paddingRight="15dp" android:textSize="16sp" android:focusable="false" android:clickable="false"/>
            </FrameLayout>

            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <Button android:id="@+id/btn_radio" android:layout_width="match_parent" android:layout_height="48dp" android:text="FM Radio" android:textColor="#FFFFFF" android:background="#00000000" android:gravity="left|center_vertical" android:paddingLeft="15dp" android:textSize="18sp" android:focusable="true"/>
                <TextView android:layout_width="wrap_content" android:layout_height="48dp" android:text="〉" android:textColor="#888888" android:gravity="center_vertical" android:layout_gravity="right" android:paddingRight="15dp" android:textSize="16sp" android:focusable="false" android:clickable="false"/>
            </FrameLayout>

            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <Button android:id="@+id/btn_webserver" android:layout_width="match_parent" android:layout_height="48dp" android:text="PC Upload" android:textColor="#FFFFFF" android:background="#00000000" android:gravity="left|center_vertical" android:paddingLeft="15dp" android:textSize="18sp" android:focusable="true"/>
                <TextView android:layout_width="wrap_content" android:layout_height="48dp" android:text="〉" android:textColor="#888888" android:gravity="center_vertical" android:layout_gravity="right" android:paddingRight="15dp" android:textSize="16sp" android:focusable="false" android:clickable="false"/>
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#00000000"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="5dp">

            <ImageView
                android:id="@+id/iv_menu_preview"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_media_play"/>

            <TextView
                android:id="@+id/tv_menu_preview_title"
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:singleLine="true"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_menu_preview_artist"
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#AAAAAA"
                android:textSize="14sp"
                android:gravity="center"
                android:singleLine="true"
                android:ellipsize="end"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_browser_mode"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:orientation="horizontal"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="26dp"
            android:paddingLeft="0dp"
            android:paddingRight="0dp"
            android:paddingBottom="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_browser_path"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:singleLine="true"
                    android:text="Path: /Music"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_browser_title_clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text=""
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:visibility="gone" />
            </LinearLayout>

            <com.themoon.y1.views.EdgeFadeScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/container_browser_items"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false" />
            </com.themoon.y1.views.EdgeFadeScrollView>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/frame_browser_cover"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:visibility="gone">

            <com.themoon.y1.views.CoverArtView
                android:id="@+id/iv_browser_cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/default_album" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_videos_mode"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:background="#66000000"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/layout_videos_left_pane"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="26dp"
            android:paddingBottom="0dp"
            android:paddingLeft="0dp"
            android:paddingRight="0dp">

            <com.themoon.y1.views.EdgeFadeScrollView
                android:id="@+id/scroll_videos"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">
                <LinearLayout
                    android:id="@+id/container_video_items"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false" />
            </com.themoon.y1.views.EdgeFadeScrollView>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/frame_video_cover"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:visibility="gone">

            <com.themoon.y1.views.CoverArtView
                android:id="@+id/iv_video_cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/video_circle" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_settings_mode"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="26dp"
        android:paddingBottom="0dp"
        android:paddingLeft="0dp"
        android:paddingRight="0dp"
        android:background="#66000000"
        android:visibility="gone">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SETTINGS" android:textColor="#BBFFFFFF" android:textSize="16sp" android:textStyle="bold" android:singleLine="true" android:visibility="gone"/>
        <com.themoon.y1.views.EdgeFadeScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
            <LinearLayout android:id="@+id/container_settings_items" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        </com.themoon.y1.views.EdgeFadeScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_storage_mode"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="26dp"
        android:paddingBottom="0dp"
        android:paddingLeft="0dp"
        android:paddingRight="0dp"
        android:background="#66000000"
        android:visibility="gone">
        <TextView android:id="@+id/tv_storage_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ABOUT" android:textColor="#BBFFFFFF" android:textSize="16sp" android:textStyle="bold" android:singleLine="true" android:visibility="gone"/>
        <com.themoon.y1.views.EdgeFadeScrollView android:id="@+id/scroll_storage" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
            <LinearLayout android:id="@+id/container_storage_items" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        </com.themoon.y1.views.EdgeFadeScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_bluetooth_mode"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="26dp"
        android:paddingBottom="0dp"
        android:paddingLeft="0dp"
        android:paddingRight="0dp"
        android:background="#66000000"
        android:visibility="gone">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="BLUETOOTH SCAN" android:textColor="#BBFFFFFF" android:textSize="16sp" android:textStyle="bold" android:visibility="gone"/>
        <Button android:id="@+id/btn_scan_bt" android:layout_width="match_parent" android:layout_height="33dp" android:text="🔍 Scan Devices" android:textColor="#FFFFFF" android:textSize="16sp" android:background="#15FFFFFF" android:focusable="true"/>
        <com.themoon.y1.views.EdgeFadeScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:layout_marginTop="5dp">
            <LinearLayout android:id="@+id/container_bt_items" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        </com.themoon.y1.views.EdgeFadeScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_wifi_mode"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="26dp"
        android:paddingBottom="0dp"
        android:paddingLeft="0dp"
        android:paddingRight="0dp"
        android:background="#66000000"
        android:visibility="gone">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="WI-FI NETWORKS" android:textColor="#BBFFFFFF" android:textSize="16sp" android:textStyle="bold" android:visibility="gone"/>
        <Button android:id="@+id/btn_scan_wifi" android:layout_width="match_parent" android:layout_height="33dp" android:text="🔍 Scan Networks" android:textColor="#FFFFFF" android:textSize="16sp" android:background="#15FFFFFF" android:focusable="true"/>
        <com.themoon.y1.views.EdgeFadeScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:layout_marginTop="5dp">
            <LinearLayout android:id="@+id/container_wifi_items" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        </com.themoon.y1.views.EdgeFadeScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_wifi_keyboard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal|top"
        android:paddingTop="28dp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingBottom="6dp"
        android:background="#F4111215"
        android:visibility="gone">
        <TextView android:id="@+id/tv_keyboard_ssid" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Target: My_Home_Wifi" android:textColor="#BBFFFFFF" android:textSize="15sp" android:textStyle="bold"/>
        <TextView android:id="@+id/tv_keyboard_input" android:layout_width="match_parent" android:layout_height="34dp" android:text="" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" android:gravity="center" android:background="#222222" android:layout_marginTop="4dp" android:layout_marginBottom="6dp"/>

        <!-- Standard QWERTY Grid Keyboard -->
        <com.themoon.y1.views.QwertyKeyboardView
            android:id="@+id/keyboard_qwerty_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="visible" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_music_quiz_mode"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="28dp"
        android:paddingBottom="6dp"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:background="@drawable/quiz_bg_gradient"
        android:visibility="gone">

        <RelativeLayout android:layout_width="match_parent" android:layout_height="26dp" android:layout_marginBottom="4dp">
            <TextView android:id="@+id/tv_quiz_round" android:layout_width="wrap_content" android:minWidth="26dp" android:layout_height="26dp" android:paddingLeft="5dp" android:paddingRight="5dp" android:layout_alignParentLeft="true" android:background="@drawable/quiz_round_badge" android:gravity="center" android:text="1" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
            <TextView android:id="@+id/tv_quiz_lives" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentRight="true" android:layout_centerVertical="true" android:text="♥ ♥ ♥" android:textColor="#FF6B6B" android:textSize="15sp" android:textStyle="bold"/>
        </RelativeLayout>

        <LinearLayout android:id="@+id/layout_quiz_question_card" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/quiz_question_card" android:padding="8dp" android:layout_marginBottom="6dp">
            <TextView android:id="@+id/tv_quiz_prompt" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="What song is playing?" android:textColor="#173350" android:textSize="16sp" android:textStyle="bold" android:gravity="center"/>
        </LinearLayout>

        <ProgressBar android:id="@+id/pb_quiz_timer" style="?android:attr/progressBarStyleHorizontal" android:progressDrawable="@drawable/progress_bar_ipod" android:layout_width="match_parent" android:layout_height="6dp" android:max="1000" android:progress="1000" android:layout_marginBottom="6dp"/>

        <LinearLayout android:id="@+id/container_quiz_items" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical"/>

        <TextView android:id="@+id/tv_quiz_score" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="$0" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" android:gravity="center" android:layout_marginTop="4dp"/>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/layout_player_mode"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFFFF"
        android:visibility="gone">

        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="top" android:paddingTop="6dp" android:paddingLeft="15dp" android:paddingRight="15dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerHorizontal="true" android:text="Now Playing" android:textColor="#3C3C43" android:textSize="14sp" android:textStyle="bold" android:visibility="gone" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/iv_player_shuffle_status"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:visibility="gone"
                    android:layout_marginEnd="8dp" />

                <ImageView
                    android:id="@+id/iv_player_repeat_status"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:visibility="gone" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Center album art and metadata vertically in available space -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:paddingTop="16dp" android:paddingBottom="46dp" android:paddingLeft="14dp" android:paddingRight="14dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="top">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginRight="14dp" android:layout_marginTop="10dp">
                    <FrameLayout android:id="@+id/frame_album_art" android:layout_width="220dp" android:layout_height="220dp"
                        android:rotationY="18">
                        <com.themoon.y1.views.SmoothEdgeImageView android:id="@+id/iv_album_art" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/default_album" android:background="#DDDDDD" />
                        <ImageView android:id="@+id/iv_pause_overlay" android:layout_width="56dp" android:layout_height="56dp" android:layout_gravity="center" android:src="@android:drawable/ic_media_pause" android:visibility="gone" />
                    </FrameLayout>
                    <!-- Album art floor reflection -->
                    <FrameLayout android:id="@+id/frame_album_reflection" android:layout_width="220dp" android:layout_height="32dp" android:layout_marginTop="1dp"
                        android:rotationY="18">
                        <!-- Fades out to the bottom of the frame (SmoothEdgeImageView.useAsReflection) -->
                        <com.themoon.y1.views.SmoothEdgeImageView android:id="@+id/iv_album_reflection" android:layout_width="220dp" android:layout_height="220dp" android:layout_gravity="top" android:scaleY="-1" android:scaleType="centerCrop" android:alpha="0.30" android:src="@drawable/default_album" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginTop="28dp">
                    <TextView android:id="@+id/tv_player_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Title" android:textColor="#000000" android:textSize="19sp" android:textStyle="bold" android:gravity="left" android:singleLine="true" android:ellipsize="marquee" android:marqueeRepeatLimit="marquee_forever" android:scrollHorizontally="true" android:focusable="true" android:focusableInTouchMode="true" />
                    <TextView android:id="@+id/tv_player_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Artist" android:textColor="#3C3C43" android:textSize="15sp" android:gravity="left" android:layout_marginTop="4dp" android:singleLine="true" android:ellipsize="end" />
                    <TextView android:id="@+id/tv_player_album" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Album" android:textColor="#3C3C43" android:textSize="15sp" android:gravity="left" android:layout_marginTop="4dp" android:singleLine="true" android:ellipsize="end" />
                    <TextView android:id="@+id/tv_player_rating" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#6194D1" android:textSize="15sp" android:gravity="left" android:layout_marginTop="4dp" android:visibility="gone"/>
                    <TextView android:id="@+id/tv_player_track_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="1 of 1" android:textColor="#8E8E93" android:textSize="15sp" android:textStyle="bold" android:gravity="left" android:layout_marginTop="4dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom progress bar and track elapsed/remaining time -->
        <LinearLayout android:id="@+id/row_player_progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="horizontal" android:gravity="center_vertical" android:paddingLeft="26dp" android:paddingRight="26dp" android:paddingBottom="14dp">
            <TextView android:id="@+id/tv_player_time_current" android:layout_width="54dp" android:layout_height="wrap_content" android:text="0:00" android:textColor="#000000" android:textStyle="bold" android:textSize="16sp" android:layout_marginRight="10dp"/>
            <ProgressBar android:id="@+id/player_progress" style="?android:attr/progressBarStyleHorizontal" android:progressDrawable="@drawable/progress_bar_now_playing" android:layout_width="0dp" android:layout_height="16dp" android:layout_weight="1" android:max="1000" android:progress="0"/>
            <TextView android:id="@+id/tv_player_time_total" android:layout_width="54dp" android:layout_height="wrap_content" android:text="-0:00" android:textColor="#000000" android:textStyle="bold" android:textSize="16sp" android:layout_marginLeft="10dp"/>
        </LinearLayout>

        <!-- Temporary inline volume gauge replacing progress bar -->
        <LinearLayout android:id="@+id/row_player_volume" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="horizontal" android:gravity="center_vertical" android:paddingLeft="26dp" android:paddingRight="26dp" android:paddingBottom="14dp" android:visibility="gone">
            <ImageView android:id="@+id/tv_player_volume_down" android:layout_width="16dp" android:layout_height="18dp" android:src="@drawable/ic_ipod_volume_down" android:tint="#000000" android:scaleType="fitCenter" android:layout_marginRight="10dp" android:contentDescription="Volume Down"/>
            <ProgressBar android:id="@+id/player_volume_progress" style="?android:attr/progressBarStyleHorizontal" android:progressDrawable="@drawable/progress_bar_now_playing" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:max="30" android:progress="0"/>
            <ImageView android:id="@+id/tv_player_volume_up" android:layout_width="24dp" android:layout_height="20dp" android:src="@drawable/ic_ipod_volume_up" android:tint="#000000" android:scaleType="fitCenter" android:layout_marginLeft="10dp" android:contentDescription="Volume Up"/>
        </LinearLayout>

        <!-- Scrub seek bar with diamond thumb -->
        <LinearLayout android:id="@+id/row_player_seek" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="horizontal" android:gravity="center_vertical" android:paddingLeft="26dp" android:paddingRight="26dp" android:paddingBottom="14dp" android:visibility="gone">
            <TextView android:id="@+id/tv_player_seek_current" android:layout_width="54dp" android:layout_height="wrap_content" android:text="0:00" android:textColor="#000000" android:textStyle="bold" android:textSize="16sp" android:layout_marginRight="10dp"/>
            <SeekBar android:id="@+id/seek_player_scrub" android:layout_width="0dp" android:layout_height="16dp" android:layout_weight="1" android:max="1000" android:progress="0" android:progressDrawable="@drawable/progress_bar_now_playing" android:thumb="@drawable/seek_diamond_thumb" android:splitTrack="false" android:focusable="false" android:clickable="false"/>
            <TextView android:id="@+id/tv_player_seek_total" android:layout_width="54dp" android:layout_height="wrap_content" android:text="-0:00" android:textColor="#000000" android:textStyle="bold" android:textSize="16sp" android:layout_marginLeft="10dp"/>
        </LinearLayout>

        <!-- Quick shuffle and repeat mode toggles -->
        <LinearLayout android:id="@+id/row_player_shuffle_repeat" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="horizontal" android:gravity="center" android:paddingBottom="18dp" android:visibility="gone">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginRight="30dp">
                <ImageView android:id="@+id/iv_scrub_shuffle_icon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_shuffle" android:tint="#6194D1" android:layout_marginRight="8dp"/>
                <TextView android:id="@+id/tv_scrub_shuffle_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Off" android:textColor="#6194D1" android:textStyle="bold" android:textSize="16sp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:id="@+id/iv_scrub_repeat_icon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_repeat" android:tint="#6194D1" android:layout_marginRight="8dp"/>
                <TextView android:id="@+id/tv_scrub_repeat_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Off" android:textColor="#6194D1" android:textStyle="bold" android:textSize="16sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Star rating widget -->
        <LinearLayout android:id="@+id/row_player_rating_scrub" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="horizontal" android:gravity="center" android:paddingBottom="18dp" android:visibility="gone">
            <TextView android:id="@+id/tv_scrub_star_1" android:layout_width="32dp" android:gravity="center" android:layout_height="wrap_content" android:text="•" android:textColor="#6194D1" android:textSize="30sp" android:layout_marginLeft="4dp" android:layout_marginRight="4dp"/>
            <TextView android:id="@+id/tv_scrub_star_2" android:layout_width="32dp" android:gravity="center" android:layout_height="wrap_content" android:text="•" android:textColor="#6194D1" android:textSize="30sp" android:layout_marginLeft="4dp" android:layout_marginRight="4dp"/>
            <TextView android:id="@+id/tv_scrub_star_3" android:layout_width="32dp" android:gravity="center" android:layout_height="wrap_content" android:text="•" android:textColor="#6194D1" android:textSize="30sp" android:layout_marginLeft="4dp" android:layout_marginRight="4dp"/>
            <TextView android:id="@+id/tv_scrub_star_4" android:layout_width="32dp" android:gravity="center" android:layout_height="wrap_content" android:text="•" android:textColor="#6194D1" android:textSize="30sp" android:layout_marginLeft="4dp" android:layout_marginRight="4dp"/>
            <TextView android:id="@+id/tv_scrub_star_5" android:layout_width="32dp" android:gravity="center" android:layout_height="wrap_content" android:text="•" android:textColor="#6194D1" android:textSize="30sp" android:layout_marginLeft="4dp" android:layout_marginRight="4dp"/>
        </LinearLayout>
    </FrameLayout>

    <RelativeLayout
        android:id="@+id/layout_status_bar"
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:background="#00000000">

        <TextView
            android:id="@+id/tv_status_clock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_toLeftOf="@+id/layout_status_right_group"
            android:layout_centerVertical="true"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="12:00 AM"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/layout_status_right_group"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentRight="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView android:id="@+id/tv_status_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginRight="8dp" android:singleLine="true" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:visibility="gone" />
            <ImageView android:id="@+id/iv_status_headphone" android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_headphone" android:visibility="gone" android:layout_marginRight="6dp"/>
            <ImageView android:id="@+id/iv_status_wifi" android:layout_width="16dp" android:layout_height="16dp" android:visibility="gone" android:layout_marginRight="6dp"/>
            <ImageView android:id="@+id/iv_status_bluetooth" android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_bluetooth" android:visibility="gone" android:layout_marginRight="8dp"/>
            <TextView android:id="@+id/tv_status_battery" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="100%" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/layout_brightness_mode"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="30dp"
        android:paddingTop="36dp"
        android:background="#66000000"
        android:visibility="gone"
        android:gravity="center">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DISPLAY BRIGHTNESS" android:textColor="#BBFFFFFF" android:textSize="20sp" android:textStyle="bold" android:layout_marginBottom="30dp"/>
        <ProgressBar android:id="@+id/pb_brightness" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="20dp" android:max="255" android:layout_marginBottom="15dp"/>
        <TextView android:id="@+id/tv_brightness_val" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="100%" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_webserver_mode"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="30dp"
        android:paddingTop="36dp"
        android:background="#66000000"
        android:visibility="gone"
        android:gravity="center">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="WIRELESS PC UPLOAD" android:textColor="#BBFFFFFF" android:textSize="22sp" android:textStyle="bold" android:layout_marginBottom="40dp"/>
        <TextView android:id="@+id/tv_server_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔴 SERVER STOPPED" android:textColor="#FF5555" android:textSize="24sp" android:textStyle="bold" android:layout_marginBottom="10dp"/>
        <TextView android:id="@+id/tv_server_ip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="http://---.---.---.---:8080" android:textColor="#888888" android:textSize="18sp" android:textStyle="bold" android:layout_marginBottom="50dp"/>
        <Button android:id="@+id/btn_server_toggle" android:layout_width="350dp" android:layout_height="wrap_content" android:text="START SERVER" android:textSize="22sp" android:textColor="#FFFFFF" android:background="#00000000" android:padding="15dp" android:layout_marginBottom="30dp" android:focusable="true"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Enter the above address in your PC browser.\nPress [Back] to return." android:textColor="#888888" android:textSize="16sp" android:gravity="center"/>
    </LinearLayout>

    <!-- Video playback overlay with title and progress -->
    <FrameLayout
        android:id="@+id/layout_video_player_mode"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:visibility="gone">

        <SurfaceView android:id="@+id/surface_video" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="center" android:visibility="gone" />

        <TextView android:id="@+id/tv_video_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="top" android:padding="14dp" android:text="Video" android:textColor="#FFFFFFFF" android:textSize="16sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end" android:shadowColor="#FF000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="3"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="horizontal" android:gravity="center_vertical" android:paddingLeft="18dp" android:paddingRight="18dp" android:paddingBottom="14dp">
            <TextView android:id="@+id/tv_video_time_current" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0:00" android:textColor="#FFFFFFFF" android:textStyle="bold" android:textSize="14sp" android:layout_marginRight="10dp" android:shadowColor="#FF000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="3"/>
            <ProgressBar android:id="@+id/video_progress" style="?android:attr/progressBarStyleHorizontal" android:progressDrawable="@drawable/progress_bar_now_playing" android:layout_width="0dp" android:layout_height="20dp" android:layout_weight="1" android:max="100" android:progress="0"/>
            <TextView android:id="@+id/tv_video_time_total" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-0:00" android:textColor="#FFFFFFFF" android:textStyle="bold" android:textSize="14sp" android:layout_marginLeft="10dp" android:shadowColor="#FF000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="3"/>
        </LinearLayout>

        <!-- Temporary mode hint overlay -->
        <TextView android:id="@+id/tv_video_mode_hint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="Seek Mode" android:textColor="#FFFFFFFF" android:textSize="20sp" android:textStyle="bold" android:background="#AA000000" android:padding="14dp" android:visibility="gone"/>
    </FrameLayout>
</FrameLayout>