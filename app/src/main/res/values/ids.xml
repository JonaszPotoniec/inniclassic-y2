<?xml version="1.0" encoding="utf-8"?>
<!--
    Ids for views made in code. An id from View.generateViewId() or a plain number (1002, 999992) has no
    package byte, and on Android 4.4 each View.toString() of the view then logs
    "W/ResourceType: No package identifier when getting name for resource number 0x..." and throws and
    catches a NotFoundException. The MediaTek build of the Y2 calls View.toString() of the focused view for
    each key press and focus change, and of each TextView that it measures. So focusable views and
    TextViews made in code need resource ids.
-->
<resources>
    <item name="coverflow_title" type="id" />
    <item name="coverflow_artist" type="id" />
    <item name="wifi_power_row" type="id" />

    <!-- Main menu rows, in order. A menu with more rows uses View.generateViewId() for the rest. -->
