<?xml version="1.0" encoding="utf-8"?>
<!-- progress_bar_now_playing with a dark track, for dark Now Playing backgrounds (NowPlayingTheme) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="#2C2C2E"/>
            <stroke android:width="1dp" android:color="#48484A"/>
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <gradient
                    android:angle="90"
                    android:startColor="#3D6DA8"
                    android:centerColor="#8AB6E8"
                    android:endColor="#4A7BC0"
                    android:centerY="0.5"/>
            </shape>
        </clip>
    </item>
</layer-list>
